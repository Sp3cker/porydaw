<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Kind</key>
	<string>Xcode.Xcode3.ProjectTemplateUnitKind</string>
	<key>Identifier</key>
	<string>io.qt.XcodeTemplate.QtBridge</string>
	<key>Concrete</key>
	<true/>
	<key>Description</key>
	<string>Starter &apos;Hello, World!&apos; app with Qt Bridge.</string>
	<key>Platforms</key>
	<array>
		<string>com.apple.platform.macosx</string>
	</array>
	<key>Project</key>
	<dict>
		<key>Configurations</key>
		<dict>
			<key>Debug</key>
			<dict/>
			<key>Release</key>
			<dict/>
		</dict>
		<key>SDK</key>
		<string>macosx</string>
		<key>SharedSettings</key>
		<dict/>
	</dict>
	<key>Targets</key>
	<array>
		<dict>
			<key>BuildPhases</key>
			<array>
				<dict>
					<key>Class</key>
					<string>Sources</string>
				</dict>
				<dict>
					<key>Class</key>
					<string>Frameworks</string>
				</dict>
				<dict>
					<key>Class</key>
					<string>Resources</string>
				</dict>
			</array>
			<key>Configurations</key>
			<dict>
				<key>Debug</key>
				<dict>
					<key>COPY_PHASE_STRIP</key>
					<string>NO</string>
					<key>GCC_DYNAMIC_NO_PIC</key>
					<string>NO</string>
				</dict>
				<key>Release</key>
				<dict>
					<key>COPY_PHASE_STRIP</key>
					<string>YES</string>
					<key>DEBUG_INFORMATION_FORMAT</key>
					<string>dwarf-with-dsym</string>
				</dict>
			</dict>
			<key>Name</key>
			<string>___PACKAGENAME___</string>
			<key>ProductType</key>
			<string>com.apple.product-type.application</string>
			<key>SharedSettings</key>
			<dict>
				<key>ALWAYS_SEARCH_USER_PATHS</key>
				<string>NO</string>
				<key>PRODUCT_NAME</key>
				<string>$(TARGET_NAME)</string>
				<key>SWIFT_VERSION</key>
				<string>6.0</string>
				<key>SWIFT_OBJC_INTEROP_MODE</key>
				<string>objcxx</string>
				<key>GENERATE_INFOPLIST_FILE</key>
				<string>YES</string>
				<key>PRODUCT_BUNDLE_IDENTIFIER</key>
				<string>___VARIABLE_organizationIdentifier:bundleIdentifier___.___PACKAGENAME:bundleIdentifier___</string>
				<key>LD_RUNPATH_SEARCH_PATHS</key>
				<string>$(inherited) @executable_path/../Frameworks @loader_path/../Frameworks</string>
				<key>CLANG_CXX_LANGUAGE_STANDARD</key>
				<string>c++17</string>
			</dict>
		</dict>
	</array>
	<key>Options</key>
	<array>
		<dict>
			<key>Description</key>
			<string>Your new product&apos;s name.</string>
			<key>EmptyReplacement</key>
			<string>ProductName</string>
			<key>Identifier</key>
			<string>productName</string>
			<key>Name</key>
			<string>Product Name</string>
			<key>NotPersisted</key>
			<true/>
			<key>Required</key>
			<true/>
			<key>Type</key>
			<string>text</string>
		</dict>
		<dict>
			<key>Identifier</key>
			<string>organizationIdentifier</string>
			<key>Name</key>
			<string>Organization Identifier</string>
			<key>Description</key>
			<string>Reverse DNS, e.g. com.example</string>
			<key>EmptyReplacement</key>
			<string>com.yourCompany</string>
			<key>Type</key>
			<string>text</string>
			<key>Required</key>
			<true/>
			<key>NotPersisted</key>
			<false/>
		</dict>
		<dict>
			<key>Identifier</key>
			<string>bundleIdentifier</string>
			<key>Name</key>
			<string>Bundle Identifier</string>
			<key>Description</key>
			<string>The product's bundle identifier</string>
			<key>Type</key>
			<string>static</string>
			<key>Default</key>
			<string>___VARIABLE_organizationIdentifier:bundleIdentifier___.___VARIABLE_productName:bundleIdentifier___</string>
			<key>NotPersisted</key>
			<true/>
		</dict>
		<dict>
			<key>Identifier</key>
			<string>modelName</string>
			<key>Name</key>
			<string>Model Type Name</string>
			<key>Description</key>
			<string>Type name for the backend model (e.g. MyModel).</string>
			<key>Type</key>
			<string>text</string>
			<key>Required</key>
			<true/>
			<key>NotPersisted</key>
			<true/>
		</dict>
		<dict>
			<key>Identifier</key>
			<string>qmlFileName</string>
			<key>Name</key>
			<string>QML File Name</string>
			<key>Description</key>
			<string>Base name of the root QML file (without .qml). Default: main</string>
			<key>Type</key>
			<string>text</string>
			<key>Required</key>
			<true/>
			<key>NotPersisted</key>
			<true/>
			<key>Default</key>
			<string>main</string>
		</dict>
		<dict>
			<key>Identifier</key>
			<string>modelContextName</string>
			<key>Name</key>
			<string>Model Context Name</string>
			<key>Description</key>
			<string>Name under which the model is exposed to QML (lowerCamelCase, e.g. myModel).</string>
			<key>Type</key>
			<string>text</string>
			<key>Required</key>
			<true/>
			<key>NotPersisted</key>
			<true/>
		</dict>
	</array>
	<key>Nodes</key>
	<array>
		<string>Sources/___PACKAGENAME:identifier___.swift</string>
		<string>Sources/___VARIABLE_modelName:identifier___.swift</string>
		<string>Resources/___VARIABLE_qmlFileName:identifier___.qml</string>
	</array>
	<key>Definitions</key>
	<dict>
		<key>Sources/___PACKAGENAME:identifier___.swift</key>
		<dict>
			<key>Path</key>
			<string>Sources/App.swift</string>
			<key>Group</key>
			<array>
				<string>Sources</string>
			</array>
		</dict>
		<key>Sources/___VARIABLE_modelName:identifier___.swift</key>
		<dict>
			<key>Path</key>
			<string>Sources/Backend.swift</string>
			<key>Group</key>
			<array>
				<string>Sources</string>
			</array>
		</dict>
		<key>Resources/___VARIABLE_qmlFileName:identifier___.qml</key>
		<dict>
			<key>Path</key>
			<string>Resources/main.qml</string>
			<key>Group</key>
			<array>
				<string>Resources</string>
			</array>
		</dict>
	</dict>
</dict>
</plist>
