+#include "grid_smoke.h"
+
+#include <QCoreApplication>
+#include <QEvent>
+#include <QImage>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QPointer>
+#include <QQuickItem>
+#include <QQuickWindow>
+#include <QTest>
+
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
