+// MARK: - PitchProjection (spec §6 T3 literals + T4 parity sweep, frozen)
+//
+// Literal tables first: a port bug fails against the literals before the
+// parity sweep runs, so it is attributed to Swift, not the ABI.
+
+private func mathPitchFail(_ detail: String) -> Never {
+    fputs("SWIFT_GRID_SMOKE math-pitch FAIL: \(detail)\n", stderr)
+    fflush(stderr)
+    exit(EXIT_FAILURE)
+}
+
+/// Builds the Swift projection for a fixture: nil = chromatic, else the fold.
+private func pitchProjection(for pitches: [UInt8]?) -> PitchProjection {
+    if let pitches {
+        var projection = PitchProjection()
+        projection.buildFromPitches(pitches)
+        return projection
+    }
+    return PitchProjection()
+}
+
+/// Passes the fixture to the C++ oracle: nil (count 0) selects the chromatic
+/// build per the seam contract; otherwise the ascending fold list.
+private func withSGPitchList<R>(_ pitches: [UInt8]?, _ body: (UnsafePointer<UInt8>?, Int) -> R) -> R {
+    guard let pitches else {
+        return body(nil, 0)
+    }
+    return pitches.withUnsafeBufferPointer { buffer in
+        body(buffer.baseAddress, buffer.count)
+    }
+}
+
+private func checkPitchRowParity(_ label: String, _ pitches: [UInt8]?, _ queries: [Int]) {
+    let projection = pitchProjection(for: pitches)
+    for query in queries {
+        let swiftValue = projection.row(forPitch: query)
+        let oracleValue = withSGPitchList(pitches) { pointer, count in
+            Int(sgm_pitch_row_for_pitch(pointer, count, Int32(query)))
+        }
+        if swiftValue != oracleValue {
+            mathPitchFail(
+                "\(label) row(forPitch:\(query)) swift=\(swiftValue) oracle=\(oracleValue)")
+        }
+    }
+}
+
+private func checkPitchNearestParity(_ label: String, _ pitches: [UInt8]?, _ queries: [Int]) {
+    let projection = pitchProjection(for: pitches)
+    for query in queries {
+        let swiftValue = projection.nearestVisiblePitch(to: query)
+        let oracleValue = withSGPitchList(pitches) { pointer, count in
+            Int(sgm_pitch_nearest_visible(pointer, count, Int32(query)))
+        }
+        if swiftValue != oracleValue {
+            mathPitchFail(
+                "\(label) nearestVisiblePitch(to:\(query)) swift=\(swiftValue) oracle=\(oracleValue)")
+        }
+    }
+}
+
+private func checkPitchGeometryParity(_ label: String, _ pitches: [UInt8]?) {
+    let projection = pitchProjection(for: pitches)
+    let keyHeights: [Double] = [13, 1.25, 7]
+    let scrollYs: [Double] = [0, 6.5, 100.75]
+    let dprs: [Double] = [1, 2, 1.5, 3, 0]
+    let rowQueries: [Int] = [0, 1, 5, 127]
+    let epsilon = 0.000001
+    for keyHeight in keyHeights {
+        for scrollY in scrollYs {
+            for dpr in dprs {
+                for row in rowQueries {
+                    if row >= projection.visibleRowCount {
+                        continue
+                    }
+                    let swiftTop = projection.rowTop(
+                        row, keyHeight: keyHeight, scrollY: scrollY, dpr: dpr)
+                    let oracleTop = withSGPitchList(pitches) { pointer, count in
+                        sgm_pitch_row_top(pointer, count, Int32(row), keyHeight, scrollY, dpr)
+                    }
+                    if swiftTop != oracleTop {
+                        mathPitchFail(
+                            "\(label) rowTop(\(row),\(keyHeight),\(scrollY),\(dpr)) "
+                                + "swift=\(swiftTop) oracle=\(oracleTop)")
+                    }
+                }
+                let lastRow = projection.visibleRowCount - 1
+                let edgeRows: [Int] = [0, lastRow]
+                for row in edgeRows {
+                    let top = projection.rowTop(
+                        row, keyHeight: keyHeight, scrollY: scrollY, dpr: dpr)
+                    let bottom = projection.rowBottom(
+                        row, keyHeight: keyHeight, scrollY: scrollY, dpr: dpr)
+                    let ys: [Double] = [top, top + epsilon, bottom - epsilon]
+                    for y in ys {
+                        let swiftPitch = projection.yToPitch(
+                            y, keyHeight: keyHeight, scrollY: scrollY, dpr: dpr)
+                        let oraclePitch = withSGPitchList(pitches) { pointer, count in
+                            Int(sgm_pitch_y_to_pitch(pointer, count, y, keyHeight, scrollY, dpr))
+                        }
+                        if swiftPitch != oraclePitch {
+                            mathPitchFail(
+                                "\(label) yToPitch(\(y),\(keyHeight),\(scrollY),\(dpr)) "
+                                    + "swift=\(swiftPitch) oracle=\(oraclePitch)")
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
