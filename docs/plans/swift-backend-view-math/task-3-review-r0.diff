+private func checkGridLinesParity(_ label: String, _ map: TimeMap, from tickBegin: Tick, to tickEnd: Tick) {
+    let axis = TimeAxis(map: map)
+    let swiftLines = collectedGridLines(axis, from: tickBegin, to: tickEnd)
+    // Spec §4: the Swift caller passes its own count as capacity; a returned
+    // count different from the Swift count is a failure.
+    var oracleLines = [SGGridLine](
+        repeating: SGGridLine(tick: 0, isBar: 0, bar: 0, beat: 0), count: swiftLines.count)
+    let needed = withSGTimeMapFixture(map) { fixture -> Int in
+        var mutableFixture = fixture
+        return oracleLines.withUnsafeMutableBufferPointer { out in
+            sgm_timeaxis_grid_lines(&mutableFixture, tickBegin, tickEnd, out.baseAddress, out.count)
+        }
+    }
+    if needed != swiftLines.count {
+        mathTimeaxisFail("\(label) grid(\(tickBegin),\(tickEnd)) count swift=\(swiftLines.count) oracle=\(needed)")
+    }
+    for i in 0..<swiftLines.count {
+        let swiftLine = swiftLines[i]
+        let oracleLine = oracleLines[i]
+        if swiftLine.tick != oracleLine.tick || swiftLine.isBar != (oracleLine.isBar != 0)
+            || swiftLine.bar != Int(oracleLine.bar) || swiftLine.beat != Int(oracleLine.beat)
+        {
+            mathTimeaxisFail(
+                "\(label) grid(\(tickBegin),\(tickEnd)) line \(i) "
+                    + "swift=(\(swiftLine.tick),\(swiftLine.isBar),\(swiftLine.bar),\(swiftLine.beat)) "
+                    + "oracle=(\(oracleLine.tick),\(oracleLine.isBar),\(oracleLine.bar),\(oracleLine.beat))")
+        }
+    }
+}
