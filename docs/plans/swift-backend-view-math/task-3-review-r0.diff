+private func runMathPitchSelftest() {
+    // Chromatic (default init).
+    let chromatic = PitchProjection()
+    if chromatic.visibleRowCount != 128 {
+        mathPitchFail("chromatic visibleRowCount == \(chromatic.visibleRowCount)")
+    }
+    if chromatic.visiblePitch(at: 0) != 127 || chromatic.visiblePitch(at: 127) != 0 {
+        mathPitchFail(
+            "chromatic visiblePitch(at:0/at:127) == \(chromatic.visiblePitch(at: 0))/\(chromatic.visiblePitch(at: 127))"
+        )
+    }
+    if chromatic.row(forPitch: 127) != 0 || chromatic.row(forPitch: 0) != 127
+        || chromatic.row(forPitch: 60) != 67
+    {
+        mathPitchFail("chromatic row(forPitch:) mapping")
+    }
+    if chromatic.row(forPitch: -1) != PitchProjection.cHiddenRow
+        || chromatic.row(forPitch: 128) != PitchProjection.cHiddenRow
+    {
+        mathPitchFail("chromatic row(forPitch:) out-of-domain")
+    }
+    for query in [0, 60, 127] {
+        if chromatic.nearestVisiblePitch(to: query) != query {
+            mathPitchFail("chromatic nearestVisiblePitch(to:\(query))")
+        }
+    }
+    for row in 0..<128 {
+        if !chromatic.isScalePitch(row: row) {
+            mathPitchFail("chromatic isScalePitch(row:\(row)) == false")
+        }
+    }
+    if chromatic.totalHeight(keyHeight: 13) != 1664 {
+        mathPitchFail("chromatic totalHeight(keyHeight:13) == \(chromatic.totalHeight(keyHeight: 13))")
+    }
+
+    // Folded [60, 64, 67].
+    var folded = PitchProjection()
+    folded.buildFromPitches([60, 64, 67])
+    if folded.visibleRowCount != 3 {
+        mathPitchFail("folded visibleRowCount == \(folded.visibleRowCount)")
+    }
+    if folded.visiblePitch(at: 0) != 67 || folded.visiblePitch(at: 1) != 64
+        || folded.visiblePitch(at: 2) != 60
+    {
+        mathPitchFail("folded visiblePitch order")
+    }
+    if folded.row(forPitch: 60) != 2 || folded.row(forPitch: 64) != 1
+        || folded.row(forPitch: 67) != 0 || folded.row(forPitch: 61) != PitchProjection.cHiddenRow
+    {
+        mathPitchFail("folded row(forPitch:) mapping")
+    }
+    let nearestCases: [(query: Int, expected: Int)] = [
+        (62, 60), (65, 64), (59, 60), (68, 67),
+    ]
+    for c in nearestCases {
+        let swiftValue = folded.nearestVisiblePitch(to: c.query)
+        if swiftValue != c.expected {
+            mathPitchFail(
+                "folded nearestVisiblePitch(to:\(c.query)) == \(swiftValue), want \(c.expected)")
+        }
+    }
+    for row in 0..<3 {
+        if !folded.isScalePitch(row: row) {
+            mathPitchFail("folded isScalePitch(row:\(row)) == false before classification")
+        }
+    }
+    var classifiedFlags = Array(repeating: false, count: 128)
+    classifiedFlags[64] = true
+    folded.setScalePitchClassification(classifiedFlags)
+    if folded.isScalePitch(row: 0) || !folded.isScalePitch(row: 1) || folded.isScalePitch(row: 2) {
