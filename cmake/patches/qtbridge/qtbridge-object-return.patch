@@ -0,0 +1,63 @@
+#pragma once
+
+#include <QtCore/qabstractitemmodel.h>
+#include <QtCore/qpointer.h>
+#include <QtQuick/qquickitem.h>
+
+#include <vector>
+
+class QuickDisplayListItem : public QQuickItem
+{
+    Q_OBJECT
+    Q_PROPERTY(QAbstractItemModel *rects READ rects WRITE setRects NOTIFY rectsChanged)
+    // When true, one invisible QQuickItem child mirrors every snapshot row so
+    // QML/tests keep objectName lookup and per-row geometry without delegate
+    // reads crossing the bridge. Costs one child per row; opt-in per item.
+    Q_PROPERTY(bool exposeRows READ exposeRows WRITE setExposeRows NOTIFY exposeRowsChanged)
+
+public:
+    explicit QuickDisplayListItem(QQuickItem *parent = nullptr);
+
+    QAbstractItemModel *rects() const;
+    void setRects(QAbstractItemModel *rects);
+
+    bool exposeRows() const;
+    void setExposeRows(bool exposeRows);
+
+signals:
+    void rectsChanged();
+    void exposeRowsChanged();
+
+protected:
+    QSGNode *updatePaintNode(QSGNode *oldNode, UpdatePaintNodeData *) override;
+
+private:
+    struct Rect {
+        float x;
+        float y;
+        float width;
+        float height;
+        unsigned char red;
+        unsigned char green;
+        unsigned char blue;
+        unsigned char alpha;
+    };
+    struct Row {
+        Rect rect;
+        QByteArray name;
+        QVariant color;
+        QString fillColor;
+    };
+
+    void rebuildSnapshot();
+    void syncExposedRows(const std::vector<Row> &rows);
+    void clearExposedRows();
+
+    QPointer<QAbstractItemModel> m_rects;
+    QHash<int, QByteArray> m_roleNames;
+    std::vector<Rect> m_snapshot;
+    std::vector<QPointer<QQuickItem>> m_rowItems;
+    bool m_exposeRows = false;
+};
+
+void registerQuickDisplayListQmlType();
