+namespace {
+// Same-thread emissions batch here so one queued post + wakeup flushes a
+// whole event-loop turn in FIFO order; cross-thread keeps the direct path.
+struct PendingEmission {
+    QPointer<QObject> sender;
+    int signalIndex = -1;
+    std::vector<QVariant> args;
+};
+
+// The dispatcher is never deleted: thread-exit destruction can outlive Qt's
+// thread data. `spare` keeps the drained batch's capacity for the next turn.
+struct EmissionFlush {
+    std::vector<PendingEmission> pending;
+    std::vector<PendingEmission> spare;
+    QObject *dispatcher = nullptr;
+};
+
+thread_local EmissionFlush t_emissions;
+
+void flushEmissions()
+{
+    // Swap out first so emissions from slots start a new batch + post,
+    // keeping 'later than now' ordering. Dead senders are skipped.
+    std::vector<PendingEmission> batch;
+    batch.swap(t_emissions.pending);
+    t_emissions.pending.swap(t_emissions.spare);
+    std::vector<void *> argv;
+    for (auto &entry : batch) {
+        QObject *target = entry.sender.data();
+        if (!target)
+            continue;
+        argv.clear();
+        argv.push_back(nullptr); // Signal return value
+        for (auto &arg : entry.args)
+            argv.push_back(arg.data());
+        QMetaObject::activate(target, entry.signalIndex, argv.data());
+    }
+    batch.clear();
+    if (t_emissions.spare.capacity() < batch.capacity())
+        t_emissions.spare.swap(batch);
+}
