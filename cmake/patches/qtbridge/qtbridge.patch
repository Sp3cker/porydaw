diff --git a/Sources/QtBridgeCpp/include/qmlvaluetypes.h b/Sources/QtBridgeCpp/include/qmlvaluetypes.h
new file mode 100644
index 0000000..24f562b
--- /dev/null
+++ b/Sources/QtBridgeCpp/include/qmlvaluetypes.h
@@ -0,0 +1,92 @@
+// Copyright (C) 2025 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR GPL-3.0-only
+
+#pragma once
+
+#include <QtCore/QVariant>
+#include <QtGui/QColor>
+#include <QtGui/QFont>
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+struct QmlColorComponents
+{
+    double red;
+    double green;
+    double blue;
+    double alpha;
+};
+
+struct QmlFontFeature
+{
+    QmlFontFeature(const QString &tag, quint32 value) : tag(tag), value(value) {}
+    QString tag;
+    quint32 value;
+};
+
+using CppVectorOfFontFeatures = std::vector<QmlFontFeature>;
+
+struct QmlFontComponents
+{
+    QString family;
+    int pixelSize;
+    int weight;
+    bool italic;
+    double letterSpacing;
+    int hintingPreference;
+    CppVectorOfFontFeatures features;
+};
+
+class QmlValueTypesCpp
+{
+public:
+    static int colorMetaType() { return QMetaType::QColor; }
+    static int fontMetaType() { return QMetaType::QFont; }
+
+    static QVariant variantFromColor(double red, double green, double blue, double alpha)
+    {
+        return QVariant::fromValue(QColor::fromRgbF(red, green, blue, alpha));
+    }
+
+    static QmlColorComponents colorFromVariant(const QVariant &variant)
+    {
+        const QColor color = variant.value<QColor>();
+        return {color.redF(), color.greenF(), color.blueF(), color.alphaF()};
+    }
+
+    static QVariant variantFromFont(const QString &family, int pixelSize, int weight,
+                                    bool italic, double letterSpacing, int hintingPreference,
+                                    const CppVectorOfFontFeatures &features)
+    {
+        QFont font;
+        font.setFamily(family);
+        font.setPixelSize(pixelSize);
+        font.setWeight(static_cast<QFont::Weight>(weight));
+        font.setItalic(italic);
+        font.setLetterSpacing(QFont::AbsoluteSpacing, letterSpacing);
+        font.setHintingPreference(static_cast<QFont::HintingPreference>(hintingPreference));
+        for (const auto &feature : features) {
+            // Skip tags that are not exactly four ASCII characters, or are invalid to Qt.
+            if (feature.tag.size() != 4
+                || std::any_of(feature.tag.cbegin(), feature.tag.cend(),
+                               [](QChar character) { return character.unicode() > 0x7f; }))
+                continue;
+            if (const auto tag = QFont::Tag::fromString(feature.tag))
+                font.setFeature(*tag, feature.value);
+        }
+        return QVariant::fromValue(font);
+    }
+
+    static QmlFontComponents fontFromVariant(const QVariant &variant)
+    {
+        const QFont font = variant.value<QFont>();
+        CppVectorOfFontFeatures features;
+        const auto tags = font.featureTags();
+        features.reserve(tags.size());
+        for (const auto tag : tags)
+            features.emplace_back(QString::fromLatin1(tag.toString()), font.featureValue(tag));
+        return {font.family(), font.pixelSize(), static_cast<int>(font.weight()), font.italic(),
+                font.letterSpacing(), static_cast<int>(font.hintingPreference()), std::move(features)};
+    }
+};
