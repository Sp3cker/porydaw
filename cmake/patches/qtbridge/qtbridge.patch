+    // Swap out first so emissions from slots start a new batch + post,
+    // keeping 'later than now' ordering. Dead senders are skipped.
+    std::vector<PendingEmission> batch;
+    batch.swap(t_emissions.pending);
+    t_emissions.pending.swap(t_emissions.spare);
