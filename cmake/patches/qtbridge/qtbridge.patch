diff --git a/Sources/QtBridge/QmlColor.swift b/Sources/QtBridge/QmlColor.swift
new file mode 100644
index 0000000..a0c2876
--- /dev/null
+++ b/Sources/QtBridge/QmlColor.swift
@@ -0,0 +1,37 @@
+// Copyright (C) 2025 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only
+
+import QtBridgeCpp
+
+/// An RGBA value exposed to QML as a native `color`.
+public struct QmlColor: Equatable, Sendable {
+    public var red: Double
+    public var green: Double
+    public var blue: Double
+    public var alpha: Double
+
+    /// Creates a color from normalized channels in the range 0...1.
+    public init(red: Double, green: Double, blue: Double, alpha: Double = 1) {
+        self.red = red
+        self.green = green
+        self.blue = blue
+        self.alpha = alpha
+    }
+
+    /// Creates a color from 8-bit RGBA channels.
+    public init(red8: UInt8, green8: UInt8, blue8: UInt8, alpha8: UInt8 = 255) {
+        self.init(red: Double(red8) / 255, green: Double(green8) / 255,
+                  blue: Double(blue8) / 255, alpha: Double(alpha8) / 255)
+    }
+}
+
+extension QmlColor: QVariantSettable {
+    public func toVariant() -> QVariant { QVariant(value: self) }
+
+    public static func value(from variant: QVariant) -> QmlColor {
+        let color = QmlValueTypesCpp.colorFromVariant(variant.cppVariant())
+        return QmlColor(red: color.red, green: color.green, blue: color.blue, alpha: color.alpha)
+    }
+
+    public static func metaType() -> Int32 { QmlValueTypesCpp.colorMetaType() }
+}
diff --git a/Sources/QtBridge/QmlFont.swift b/Sources/QtBridge/QmlFont.swift
new file mode 100644
index 0000000..732931f
--- /dev/null
+++ b/Sources/QtBridge/QmlFont.swift
@@ -0,0 +1,60 @@
+// Copyright (C) 2025 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only
+
+import QtBridgeCpp
+
+/// A pixel-sized font exposed to QML as a native `font`.
+public struct QmlFont: Equatable, Sendable {
+    /// Qt's font hinting preference values.
+    public enum HintingPreference: Int32, Sendable {
+        case preferDefaultHinting = 0
+        case preferNoHinting = 1
+        case preferVerticalHinting = 2
+        case preferFullHinting = 3
+    }
+
+    public var family: String
+    public var pixelSize: Int
+    public var weight: Int
+    public var italic: Bool
+    public var letterSpacing: Double
+    public var hintingPreference: HintingPreference
+    /// OpenType feature values; tags other than four ASCII characters are skipped when converting to Qt.
+    public var features: [String: UInt32]
+
+    /// Creates a font with Qt's 1...1000 weight scale and absolute pixel letter spacing.
+    public init(family: String, pixelSize: Int, weight: Int = 400, italic: Bool = false,
+                letterSpacing: Double = 0, hintingPreference: HintingPreference = .preferNoHinting,
+                features: [String: UInt32] = [:]) {
+        self.family = family
+        self.pixelSize = pixelSize
+        self.weight = weight
+        self.italic = italic
+        self.letterSpacing = letterSpacing
+        self.hintingPreference = hintingPreference
+        self.features = features
+    }
+}
+
+extension QmlFont: QVariantSettable {
+    public func toVariant() -> QVariant { QVariant(value: self) }
+
+    public static func value(from variant: QVariant) -> QmlFont {
+        let font = QmlValueTypesCpp.fontFromVariant(variant.cppVariant())
+        guard let hinting = HintingPreference(rawValue: font.hintingPreference) else {
+            preconditionFailure("Unknown Qt font hinting preference")
+        }
+        var features: [String: UInt32] = [:]
+        features.reserveCapacity(Int(font.features.size()))
+        for index in 0..<font.features.size() {
+            let feature = font.features[index]
+            features[feature.tag.toSwiftString()] = feature.value
+        }
+        return QmlFont(family: font.family.toSwiftString(), pixelSize: Int(font.pixelSize),
+                       weight: Int(font.weight), italic: font.italic,
+                       letterSpacing: font.letterSpacing, hintingPreference: hinting,
+                       features: features)
+    }
+
+    public static func metaType() -> Int32 { QmlValueTypesCpp.fontMetaType() }
+}
