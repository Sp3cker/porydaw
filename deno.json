{
  "permissions": {
    "checks": {
      "read": true,
      "write": true,
      "run": true,
      "env": [
        "ASAN_OPTIONS",
        "DISPLAY",
        "LLVM_PROFILE_FILE",
        "PORYDAW_SAMPLE_CORPUS",
        "PORYDAW_SMF_STRESS"
      ]
    }
  },
  "tasks": {
    "checks": "deno run -P=checks tools/run_checks.ts"
  },
  "fmt": {
    "include": ["tools/**/*.ts"]
  },
  "lint": {
    "include": ["tools/**/*.ts"]
  }
}
