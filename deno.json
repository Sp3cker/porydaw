{
  "tasks": {
    "checks": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts checks",
    "checks:backups": "swift test --package-path src/swift/backups --scratch-path build/backups",
    "build": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts build",
    "build:app": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts build:app",
    "build:checks": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts build:checks",
    "bench:startup": "deno run --allow-read --allow-run tools/startup_bench.ts",
    "bench:startup:ab": "deno run --allow-read --allow-run tools/startup_ab.ts",
    "bench:swift-compile": "deno run --allow-read --allow-write --allow-run --allow-env tools/swift_compile_bench.ts",
    "setup": "deno run --allow-read --allow-write --allow-run --allow-env tools/setup.ts",
    "setup:check": "deno check tools/setup.ts tools/swift_compile_bench.ts && deno test --allow-read --allow-write --allow-run --allow-env tools/setup_test.ts tools/setup_swift_test.ts tools/cli_test.ts tools/swift_compile_bench_test.ts",
    "checks:bridge": "deno run --allow-read=src,CMakeLists.txt,cmake/QtBridge.cmake,tools --allow-run tools/cli.ts checks:bridge",
    "bridge:baseline": "deno run --allow-read=src,CMakeLists.txt,cmake/QtBridge.cmake,tools --allow-write=tools --allow-run tools/cli.ts checks:bridge --update-baseline --allow-growth",
    "checks:qml-aot": "deno run --allow-read --allow-write=build --allow-run --allow-env tools/cli.ts checks:qml-aot",
    "qml-aot:baseline": "deno run --allow-read --allow-write=build,tools --allow-run --allow-env tools/cli.ts checks:qml-aot --update-baseline --allow-growth",
    "checks:qml": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts checks:qml",
    "checks:qml-roll": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts checks:qml-roll",
    "checks:shell": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts checks:shell",
    "format": "deno run --allow-read --allow-write --allow-run --allow-env=HOME,SWIFTC tools/cli.ts format",
    "proof": "deno run --allow-read=src/checks,build/debug/proof-evidence tools/proof_reader.ts",
    "proof:edit": "deno run --allow-read=src/checks --allow-write=src/checks tools/proof_editor.ts",
    "proof:compact": "deno run --allow-read=src/checks --allow-write=src/checks --allow-run=git tools/proof_compact.ts",
    "lsp:swift": "python3 tools/gen_swift_compdb.py --index",
    "worktree:create": "deno run --allow-read --allow-write --allow-run tools/worktree.ts create",
    "xctrace": "deno run --allow-read --allow-write --allow-run=xcrun --allow-env=HOME,TMPDIR tools/xctrace.ts"
  },
  "imports": {
    "saxes": "npm:saxes@6.0.0"
  },
  "fmt": {
    "include": ["tools/**/*.ts"]
  },
  "lint": {
    "include": ["tools/**/*.ts"]
  }
}
