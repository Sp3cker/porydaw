{
  "tasks": {
    "checks": "deno run --allow-read --allow-write --allow-run --allow-env=ASAN_OPTIONS,DISPLAY,HOME,LLVM_PROFILE_FILE,PORYDAW_SAMPLE_CORPUS tools/cli.ts verify",
    "build:app": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts build:app",
    "build:render": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts build:render",
    "build:checks": "deno run --allow-read --allow-write --allow-run --allow-env tools/cli.ts build:checks",
    "setup": "deno run --allow-read --allow-write --allow-run --allow-env tools/setup.ts",
    "setup:check": "deno check tools/setup.ts && deno test --allow-read --allow-write --allow-run --allow-env tools/setup_test.ts tools/setup_swift_test.ts",
    "verify": "deno run --allow-read --allow-write --allow-run --allow-env=ASAN_OPTIONS,DISPLAY,HOME,LLVM_PROFILE_FILE,PORYDAW_SAMPLE_CORPUS tools/cli.ts verify",
    "verify:qml": "deno run --allow-read --allow-write --allow-run --allow-env=ASAN_OPTIONS,DISPLAY,HOME,LLVM_PROFILE_FILE,PORYDAW_SAMPLE_CORPUS tools/cli.ts verify:qml",
    "verify:qml-roll": "deno run --allow-read --allow-write --allow-run --allow-env=ASAN_OPTIONS,DISPLAY,HOME,LLVM_PROFILE_FILE,PORYDAW_SAMPLE_CORPUS tools/cli.ts verify:qml-roll",
    "verify:shell": "deno run --allow-read --allow-write --allow-run --allow-env=ASAN_OPTIONS,DISPLAY,HOME,LLVM_PROFILE_FILE,PORYDAW_SAMPLE_CORPUS tools/cli.ts verify:shell",
    "format": "deno run --allow-read --allow-write --allow-run --allow-env=CLANG_FORMAT tools/cli.ts format",
    "format:check": "deno run --allow-read --allow-write --allow-run --allow-env=CLANG_FORMAT tools/cli.ts format --check",
    "coverage": "deno run --allow-read --allow-write --allow-run --allow-env=CI,PORYDAW_COVERAGE_IN_CI tools/coverage.ts",
    "proof": "deno run --allow-read=src/checks,build/proof-evidence tools/proof_reader.ts",
    "proof:edit": "deno run --allow-read=src/checks --allow-write=src/checks tools/proof_editor.ts",
    "lsp:swift": "python3 tools/gen_swift_compdb.py --index",
