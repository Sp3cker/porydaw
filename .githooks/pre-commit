#!/bin/sh

repo_root=$(git rev-parse --show-toplevel) || {
    echo "pre-commit: not inside a Git repository" >&2
    exit 1
}

cd "$repo_root" || exit 1

if ! uv run --no-sync dev format --check; then
    echo "pre-commit: run uv sync --locked if the environment is missing; otherwise run uv run --no-sync dev format, then retry the commit." >&2
    exit 1
fi
